{
    "name": "swp/memory-profiler",
    "description": "Profiles request peak memory usage in Shopware 6 with admin dashboard",
    "version": "2.0.0",
    "type": "shopware-platform-plugin",
    "license": "AGPL-3.0",
    "authors": [
        { "name": "Horst" }
    ],
    "require": {
        "shopware/core": "~6.6.0",
        "shopware/administration": "~6.6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "phpstan/phpstan-symfony": "^1.4"
    },
    "extra": {
        "shopware-plugin-class": "Swp\\MemoryProfiler\\SwpMemoryProfiler",
        "label": {
            "de-DE": "Memory Profiler",
            "en-GB": "Memory Profiler"
        },
        "description": {
            "de-DE": "Loggt Peak-Memory pro Request mit Admin-Dashboard",
            "en-GB": "Logs peak memory per request with admin dashboard"
        }
    },
    "autoload": {
        "psr-4": {
            "Swp\\MemoryProfiler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Swp\\MemoryProfiler\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "stan": "phpstan analyse src --memory-limit=512M"
    }
}
