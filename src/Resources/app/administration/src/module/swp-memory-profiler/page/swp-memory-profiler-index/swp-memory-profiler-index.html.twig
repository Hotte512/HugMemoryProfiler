{% block swp_memory_profiler_index %}
<sw-page class="swp-memory-profiler-index">

    {% block swp_memory_profiler_index_smart_bar_header %}
        <template #smart-bar-header>
            <h2>{{ $tc('swp-memory-profiler.general.mainMenuItemTitle') }}</h2>
        </template>
    {% endblock %}

    {% block swp_memory_profiler_index_smart_bar_actions %}
        <template #smart-bar-actions>
            <sw-button @click="loadData" :isLoading="isLoading">
                {{ $tc('swp-memory-profiler.actions.refresh') }}
            </sw-button>
            <sw-button variant="danger" @click="openClearModal">
                {{ $tc('swp-memory-profiler.actions.clear') }}
            </sw-button>
        </template>
    {% endblock %}

    {% block swp_memory_profiler_index_content %}
        <template #content>
            <sw-card-view>

                {# Stats-Karten #}
                {% block swp_memory_profiler_index_stats %}
                    <sw-card position-identifier="swp-memory-stats" :isLoading="isLoading">
                        <template #title>{{ $tc('swp-memory-profiler.stats.title') }}</template>

                        <div v-if="stats" class="swp-memory-stats__grid">
                            <div class="swp-stat-box">
                                <div class="swp-stat-box__label">Requests gesamt</div>
                                <div class="swp-stat-box__value">{{ stats.totals.total }}</div>
                            </div>
                            <div class="swp-stat-box">
                                <div class="swp-stat-box__label">Avg Peak</div>
                                <div class="swp-stat-box__value">{{ stats.totals.avg_mb }} MB</div>
                            </div>
                            <div class="swp-stat-box">
                                <div class="swp-stat-box__label">Max Peak</div>
                                <div class="swp-stat-box__value">{{ stats.totals.peak_mb }} MB</div>
                            </div>
                            <div class="swp-stat-box">
                                <div class="swp-stat-box__label">Zeitraum</div>
                                <div class="swp-stat-box__value swp-stat-box__value--small">
                                    {{ stats.range.oldest }}<br>
                                    {{ stats.range.newest }}
                                </div>
                            </div>
                        </div>

                        <div v-if="stats && stats.byContext.length" class="swp-memory-stats__contexts">
                            <h3>Pro Kontext</h3>
                            <table class="swp-stats-table">
                                <thead>
                                    <tr>
                                        <th>Kontext</th>
                                        <th>Anzahl</th>
                                        <th>Avg MB</th>
                                        <th>Peak MB</th>
                                        <th>Avg ms</th>
                                        <th>Max ms</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-for="row in stats.byContext" :key="row.context">
                                        <td><strong>{{ row.context }}</strong></td>
                                        <td>{{ row.cnt }}</td>
                                        <td>{{ row.avg_mb }}</td>
                                        <td>{{ row.peak_mb }}</td>
                                        <td>{{ row.avg_ms }}</td>
                                        <td>{{ row.max_ms }}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </sw-card>
                {% endblock %}

                {# Filter #}
                {% block swp_memory_profiler_index_filters %}
                    <sw-card position-identifier="swp-memory-filters">
                        <template #title>Filter</template>
                        <div class="swp-filters__grid">
                            <sw-select-field
                                v-model:value="filter.context"
                                :options="contextOptions"
                                label="Kontext"
                            />
                            <sw-select-field
                                v-model:value="filter.hours"
                                :options="timeRangeOptions"
                                label="Zeitraum"
                            />
                            <sw-text-field
                                v-model:value="filter.route"
                                label="Route enthält"
                                placeholder="z.B. /checkout"
                            />
                            <sw-text-field
                                v-model:value="filter.status"
                                label="Status-Code"
                                placeholder="200"
                            />
                            <sw-text-field
                                v-model:value="filter.minPeak"
                                label="Min Peak (MB)"
                                placeholder="100"
                            />
                        </div>
                    </sw-card>
                {% endblock %}

                {# Tabelle #}
                {% block swp_memory_profiler_index_table %}
                    <sw-card position-identifier="swp-memory-table" :isLoading="isLoading">
                        <template #title>Einträge ({{ total }})</template>

                        <sw-data-grid
                            :dataSource="entries"
                            :columns="columns"
                            :showSelection="false"
                            :showActions="false"
                            :sortBy="sortBy"
                            :sortDirection="sortDirection"
                            @column-sort="onSortColumn"
                        >
                            <template #column-peak_memory_mb="{ item }">
                                <span :class="rowClass(item)">{{ item.peak_memory_mb }} MB</span>
                            </template>
                            <template #column-status_code="{ item }">
                                <sw-color-badge
                                    :variant="item.status_code >= 500 ? 'critical' : item.status_code >= 400 ? 'warning' : 'success'"
                                />
                                {{ item.status_code }}
                            </template>
                            <template #column-path="{ item }">
                                <span class="swp-path">{{ item.method }} {{ item.path }}<span v-if="item.query_string">?{{ item.query_string }}</span></span>
                            </template>
                        </sw-data-grid>

                        <sw-pagination
                            :page="page"
                            :limit="limit"
                            :total="total"
                            :steps="[25, 50, 100, 250]"
                            @page-change="onPageChange"
                        />
                    </sw-card>
                {% endblock %}

            </sw-card-view>

            {# Clear Modal #}
            <sw-modal
                v-if="showClearModal"
                title="Einträge löschen"
                @modal-close="showClearModal = false"
            >
                <p>Wie viele Tage Daten sollen aufbewahrt werden?</p>
                <sw-text-field
                    v-model:value="clearOlderThan"
                    label="Älter als (Tage) löschen"
                    helpText="Leer lassen für Komplett-Reset"
                />
                <template #modal-footer>
                    <sw-button @click="showClearModal = false">Abbrechen</sw-button>
                    <sw-button variant="danger" @click="onClearConfirm" :isLoading="isLoading">
                        Löschen
                    </sw-button>
                </template>
            </sw-modal>
        </template>
    {% endblock %}

</sw-page>
{% endblock %}
