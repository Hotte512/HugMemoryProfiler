<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
                               http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Swp\MemoryProfiler\Subscriber\MemoryProfilerSubscriber">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument>%swp_memory_profiler.enabled%</argument>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Swp\MemoryProfiler\ScheduledTask\CleanupTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="Swp\MemoryProfiler\ScheduledTask\CleanupTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument>%swp_memory_profiler.retention_days%</argument>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="Swp\MemoryProfiler\Command\ReportCommand">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="console.command"/>
        </service>

        <service id="Swp\MemoryProfiler\Command\ClearCommand">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="console.command"/>
        </service>

        <service id="Swp\MemoryProfiler\Controller\MemoryProfileController" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>

    <parameters>
        <parameter key="swp_memory_profiler.enabled">true</parameter>
        <parameter key="swp_memory_profiler.retention_days">30</parameter>
    </parameters>
</container>
